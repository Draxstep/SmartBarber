# ==============================================================================
# SMARTBARBER - ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# Copia este archivo a '.env' y completa los valores correspondientes.
# NUNCA subas el archivo '.env' con secretos al sistema de control de versiones.
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Puerto del servidor backend (Modular Monolith)
PORT=3001

# Zona horaria operativa (Bogotá, Colombia UTC-5)
TZ=America/Bogota

# ==============================================================================
# CONEXIÓN A BASE DE DATOS (POSTGRESQL 15+)
# ==============================================================================
# Formato: postgres://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/smartbarber_db

# Habilitar conexión segura SSL (obligatorio para RDS/Cloud, 'true' o 'false')
DB_SSL=true

# Ignorar validación de certificado autofirmado en desarrollo/RDS (true/false)
DB_SSL_REJECT_UNAUTHORIZED=false

# Tamaño del pool de conexiones PostgreSQL
DB_POOL_MIN=2
DB_POOL_MAX=20

# Timeouts de conexión y de inactividad (milisegundos)
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
